# CLOG MAINNET deployment environment - copy to .env.mainnet and fill in.
# Every name below is copied verbatim from the actual vm.envAddress/vm.envUint/
# vm.envString/vm.envBytes32 calls in script/DeployRobinhoodChain.s.sol,
# script/DeployArbitrumWrapper.s.sol, and script/WireCrossChain.s.sol - nothing
# here is invented. See DEPLOY_MAINNET.md for what each one is and where to
# find the real value.
#
# THIS IS REAL MONEY. This deployment targets Robinhood Chain MAINNET
# (chain id 4663) and Arbitrum ONE mainnet, not a testnet. Every address
# below is a real, immutable, production configuration value once broadcast.

# ── DeployRobinhoodChain.s.sol ──────────────────────────────────────────────
# Run with --rpc-url pointed at Robinhood Chain Mainnet.

# UNRESOLVED - see DEPLOY_MAINNET.md "Values I could not verify". Do not fill
# this in with a guessed address. Confirm against Chainlink's own CCIP
# Directory for Robinhood Chain Mainnet before using.
CCIP_ROUTER_ROBINHOOD=

# UNRESOLVED - see DEPLOY_MAINNET.md. The CCIP chain selector Chainlink
# assigns to Arbitrum One, as listed against Robinhood Chain Mainnet's own
# CCIP Directory entry.
ARBITRUM_CHAIN_SELECTOR=

# The Safe multisig address that will hold the TimelockController's proposer
# role on Robinhood Chain Mainnet. Must already exist (Safe deployment is out
# of scope for these scripts - see DeployRobinhoodChain.s.sol's own
# contract-level notes). This is the address that will govern the protocol
# forever after deployment - there is no transfer path.
SAFE_ADDRESS=

# Recipient of the 10% trading-tax/launch-fee share routed to the protocol
# multisig (see BondingCurveClog's fee split). Can be the same Safe as above
# or a different address - this script does not require them to match.
FEE_MULTISIG_ADDRESS=

# Base URI for TickerNFT metadata (OpenSea-style tokenURI base, i.e. tokenId
# gets appended to this). Your own choice - not a Chainlink/chain value.
# Should point at real, permanent, production-intended metadata hosting for
# a mainnet deployment, not a placeholder.
TICKER_NFT_BASE_URI=

# ── DeployArbitrumWrapper.s.sol ─────────────────────────────────────────────
# Run with --rpc-url pointed at Arbitrum One mainnet. Run AFTER
# DeployRobinhoodChain.s.sol (needs nothing from it directly, but
# WireCrossChain.s.sol afterward needs both sides deployed).

# UNRESOLVED - see DEPLOY_MAINNET.md. The official Chainlink VRF v2.5
# Coordinator address on Arbitrum One mainnet.
VRF_COORDINATOR_ARBITRUM=

# UNRESOLVED - see DEPLOY_MAINNET.md. The official CCIP Router address on
# Arbitrum One mainnet.
CCIP_ROUTER_ARBITRUM=

# UNRESOLVED - see DEPLOY_MAINNET.md. The CCIP chain selector for Robinhood
# Chain Mainnet itself, as listed in Chainlink's CCIP Directory - this is the
# critical "does the reverse direction exist" check (Arbitrum One -> Robinhood
# Mainnet), not just the forward direction. Do not assume it exists merely
# because the forward direction (ARBITRUM_CHAIN_SELECTOR above) does.
ROBINHOOD_CHAIN_SELECTOR=

# UNRESOLVED - see DEPLOY_MAINNET.md. The official VRF v2.5 key hash (gas
# lane) for Arbitrum One mainnet.
VRF_KEY_HASH=

# YOU create this - a real Chainlink VRF v2.5 subscription on Arbitrum One
# mainnet, funded with real LINK (see DEPLOY_MAINNET.md section 4 - the
# wrapper is hardcoded to pay via subscription/LINK, not native ETH; this is
# not configurable without a Solidity change, which is out of scope right
# now). Not invented or guessed here - you supply the real ID after creating
# it via Chainlink's VRF subscription manager.
VRF_SUBSCRIPTION_ID=

# The address that should end up owning VRFWrapperOnArbitrum on Arbitrum One
# mainnet (a Safe on that chain, or a second TimelockController mirroring the
# Robinhood Chain setup - see the script's own notes on the two-step
# ConfirmedOwner transfer). Real, production governance - not a placeholder.
ARBITRUM_GOVERNANCE_ADDRESS=

# ── WireCrossChain.s.sol ─────────────────────────────────────────────────────
# Run once per chain (once with --rpc-url pointed at Robinhood Chain Mainnet,
# once pointed at Arbitrum One mainnet), after both deployments above have
# completed and you have both real addresses.

# ChainlinkRandomnessProvider's address, from DeployRobinhoodChain.s.sol's
# logged output.
CHAINLINK_RANDOMNESS_PROVIDER=

# VRFWrapperOnArbitrum's address, from DeployArbitrumWrapper.s.sol's logged
# output.
VRF_WRAPPER_ON_ARBITRUM=
