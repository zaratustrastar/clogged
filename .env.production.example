# CLOG frontend production environment - lives at /opt/clogged/.env.production
# on the VPS. NOT committed (see .gitignore's .env.* rule). Copy this file,
# fill in real values, and place it at that exact path.
#
# Every name below is the exact variable actually read somewhere in this
# codebase (verified by grepping process.env.* and lib/web3/env.ts directly -
# nothing here is invented). No blockchain deployment secret (private key,
# deployer mnemonic, Safe signer key) belongs in this file - those live only
# in the operator's own signing setup (see contracts/DEPLOY_MAINNET.md),
# never on this server, never in this file.
#
# CRITICAL: every NEXT_PUBLIC_* variable below is embedded into the compiled
# JavaScript bundle AT BUILD TIME (npm run build), not read at request time.
# Changing any NEXT_PUBLIC_* value and only running `systemctl restart clog`
# does NOTHING - the old value is already baked into .next/. The correct
# sequence after changing any value in this file is:
#
#   1. edit /opt/clogged/.env.production
#   2. cd /opt/clogged && npm run build
#   3. sudo systemctl restart clog
#
# Server-only variables (DATABASE_URL, R2_*) ARE read at request time and do
# take effect on a plain restart - but running the same build+restart
# sequence for any change is simplest and always correct.

# ── Reown / wallet connect ───────────────────────────────────────────────────
# Create the real project at https://cloud.reown.com - see contracts/DEPLOY_MAINNET.md
# section on Reown setup. Until this is set, wallet connect is cleanly
# disabled (no fake project ID is ever sent to Reown's API - see
# lib/web3/Web3Provider.tsx).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ── Robinhood Chain network ──────────────────────────────────────────────────
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# The block DeployRobinhoodChain.s.sol was actually broadcast in - scopes
# event log scans (useTokenDiscovery, useRoundHistory, etc.) so they never
# scan from genesis. Read from cast receipt / the block explorer once real.
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# The real production origin - used for absolute URLs (e.g. the
# ticker-metadata route's fallback image URL when no custom image exists).
NEXT_PUBLIC_APP_URL=https://clog.run

# ── Deployed contract addresses (Robinhood Chain Mainnet) ───────────────────
# Fill in after DeployRobinhoodChain.s.sol actually broadcasts - see
# contracts/DEPLOY_MAINNET.md and Task 10's post-deploy handoff doc for the
# exact procedure. Until all five are set, isProtocolConfigured is false and
# the app renders an honest "not configured yet" state everywhere rather
# than crashing or faking data.
NEXT_PUBLIC_TICKER_REGISTRY_ADDRESS=
NEXT_PUBLIC_TICKER_NFT_ADDRESS=
NEXT_PUBLIC_ELIGIBILITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ROUND_MANAGER_ADDRESS=
NEXT_PUBLIC_REWARD_VAULT_ADDRESS=

# ── PostgreSQL (server-only, never NEXT_PUBLIC_) ────────────────────────────
# The VPS already has PostgreSQL 16 running locally (role clogapp, db clog).
# Never paste this into Git, chat, or any client-visible context.
DATABASE_URL=postgresql://clogapp:<password>@127.0.0.1:5432/clog

# ── Uploaded image storage (server-only, never NEXT_PUBLIC_) ────────────────
# v1 uses the VPS's own persistent filesystem, not Cloudflare R2 (removed -
# see git history if S3-compatible storage is ever revisited; the adapter
# boundary in lib/storage/filesystem.ts is kept narrow specifically so a
# future swap wouldn't need application-level changes).
#
# UPLOAD_DIR must be OUTSIDE /opt/clogged (the app deployment directory) so
# uploaded files survive a git pull / redeploy independently - see
# VPS_RUNBOOK.md's upload directory setup section. Nginx serves these files
# directly at UPLOAD_PUBLIC_BASE_URL; Next.js never proxies the actual bytes.
UPLOAD_DIR=/var/lib/clog/uploads
UPLOAD_PUBLIC_BASE_URL=https://clog.run/uploads
